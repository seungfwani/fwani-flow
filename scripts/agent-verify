#!/usr/bin/env sh
# Full verification: lint -> typecheck -> test -> build.
# Generated by company-agent-harness v0.3.0. Edit commands in .agent-harness.yml.
status=0

run_step() {
  name="$1"; cmd="$2"
  if [ -z "$cmd" ]; then
    printf '\xe2\x80\xa2 %s: not configured (skip)\n' "$name"
    return 0
  fi
  printf '\n=== %s: %s ===\n' "$name" "$cmd"
  if sh -c "$cmd"; then
    printf 'OK   %s\n' "$name"
  else
    printf 'FAIL %s\n' "$name"
    status=1
  fi
}

run_step "lint"      "ruff check ."
run_step "typecheck" "mypy ."
run_step "test"      "pytest"
run_step "build"     "python -m build"

if [ "$status" -eq 0 ]; then
  printf '\nAll configured checks passed.\n'
else
  printf '\nVerification FAILED. Do not report success.\n'
fi
exit $status
