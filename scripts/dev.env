# server_new 로컬 개발용 환경 변수 (scripts/_common.sh 로 REPO_ROOT 설정 후 source)

export DEBUG=True
export RELOAD=True
export LOG_LEVEL=DEBUG

# workflow DB (docker-compose postgres:65432)
export DB_TYPE=postgresql
export DB_HOST=localhost
export DB_PORT=65432
export DB_NAME=workflow
export DB_SCHEMA=workflow
export DB_USERNAME=airflow
export DB_PASSWORD=airflow

# Airflow 메타 DB (동일 Postgres, airflow DB)
export AIRFLOW_DB_TYPE=postgresql
export AIRFLOW_DB_HOST=localhost
export AIRFLOW_DB_PORT=65432
export AIRFLOW_DB_NAME=airflow
export AIRFLOW_DB_SCHEMA=public
export AIRFLOW_DB_USERNAME=airflow
export AIRFLOW_DB_PASSWORD=airflow

# Airflow REST API (docker-compose:8082)
export AIRFLOW_HOST=localhost
export AIRFLOW_PORT=8082
export AIRFLOW_USER=fwani
export AIRFLOW_PASSWORD=fwani

# 데이터 경로 (compose 볼륨과 동일)
export LOG_DIR="${REPO_ROOT}/server/data/logs"
export DAG_DIR="${REPO_ROOT}/server/data/dags"
export UDF_DIR="${REPO_ROOT}/server/data/udfs"
export SHARED_DIR="${REPO_ROOT}/server/data/shared"
export BUILTIN_FUNC_SCRIPT_DIR="${REPO_ROOT}/builtin_functions"
